<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TVPlayout V12.9</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0/dist/css/adminlte.min.css"><link rel="stylesheet" href="/static/style.css"></head><body>
<header><div><h1>📺 TVPlayout V9</h1><span>24 HORAS · SUBTÍTULOS · RED · AUTOMATIZACIÓN</span></div><div class="status {{'ok' if obs.connected else 'bad'}}">OBS · {{'CONECTADO' if obs.connected else 'DESCONECTADO'}}</div></header>
<nav><a class="{{'a' if tab=='playout' else ''}}" href="/?tab=playout">▶ PLAYOUT</a><a class="{{'a' if tab=='scheduler' else ''}}" href="/?tab=scheduler">📅 SCHEDULER</a><a class="{{'a' if tab=='library' else ''}}" href="/?tab=library">🎬 MEDIA POOL</a><a class="{{'a' if tab=='scanner' else ''}}" href="/?tab=scanner">📡 SCANNER</a><a class="{{'a' if tab=='subs' else ''}}" href="/?tab=subs">💬 SUBTÍTULOS</a><a class="{{'a' if tab=='logo' else ''}}" href="/?tab=logo">🏷️ LOGO</a><a class="{{'a' if tab=='ads' else ''}}" href="/?tab=ads">📢 AUTO ANUNCIOS</a><a class="{{'a' if tab=='settings' else ''}}" href="/?tab=settings">⚙️ SALIDA OBS</a><a class="{{'a' if tab=='recovery' else ''}}" href="/?tab=recovery">🛡️ RECOVERY</a></nav>
<main><div id="liveNotice" class="notice" style="display:none">🔄 Cambio de audio/subtítulos aplicado al aire.</div>
{% if tab=='scanner' %}<section class="card"><h2>📡 Scanner de biblioteca</h2><p>El escaneo corre en segundo plano: no bloquea el playout ni OBS.</p>{% for f in folders %}<div class="row"><div><b>{{f.name}}</b><small>{{f.path}} · {{'RECUSIVO' if f.recursive else 'SOLO CARPETA'}}</small></div><form method="post" action="/scan/{{f.id}}"><button>🔄 Escanear</button></form></div>{% endfor %}<div id="scanStatus" class="stats"><b>Estado:</b> {{'ESCANEANDO' if state.scanner.running else 'LISTO'}} · <b>Encontrados:</b> {{state.scanner.found}} · <b>Analizados:</b> {{state.scanner.analyzed}} · <b>Pendientes:</b> {{state.scanner.pending}}</div>
{% if state.scanner.found %}<progress id="scanProgress" value="{{state.scanner.analyzed}}" max="{{state.scanner.found}}"></progress>{% endif %}{% if state.scanner.errors %}<div class="error">{% for e in state.scanner.errors[:20] %}<div>{{e}}</div>{% endfor %}</div>{% endif %}</section>
{% elif tab=='library' %}<section class="card"><h2>📁 Carpetas</h2><form method="post" action="/folder/add" class="form"><input name="path" placeholder="C:\Peliculas o \\SERVIDOR\Videos" required><input name="name" placeholder="Nombre"><select name="category"><option>Movie</option><option>Series</option><option>Commercial</option><option>Promo</option><option>Ident</option></select><label><input type="checkbox" name="recursive" value="1" checked> Subcarpetas</label><button>＋ Agregar y escanear</button></form></section>
<section class="card"><h2>🎬 Media Pool / Editor</h2>
<p>Agregar, modificar, quitar y revisar audio/subtítulos de cada película.</p>
<div class="libraryToolbar"><input oninput="searchLibrary(this.value)" placeholder="🔎 Buscar película..." /><span id="libraryPager"></span></div>
<div id="liveMediaPool" class="media"><p>Cargando biblioteca...</p></div>
</section>
{% elif tab=='subs' %}<section class="card"><h2>💬 Subtítulos</h2><p>V9 detecta subtítulos internos del MKV y archivos externos SRT/ASS/SSA/VTT junto a la película.</p><pre>Película.mkv
Película.srt
Película.es.srt
Película.en.srt
Película.forced.es.srt</pre><div class="info">Los SRT externos se asocian por nombre de archivo. Al seleccionar uno, V9 crea un archivo temporal para reproducirlo sin modificar el original.</div></section>
{% elif tab=='scheduler' %}<section class="card"><h2>📅 Scheduler 24H por semanas</h2>
<p>El mes se genera en bloques independientes de 7 días. Esto evita una operación enorme y permite revisar cada semana.</p>
<form method="post" action="/generate-month" class="form">
<label>Mes<input type="month" name="month" value="{{month}}"></label>
<label>Modo<select name="mode"><option value="random">🎲 ALEATORIO</option><option value="sequential">📋 SECUENCIAL</option></select></label>
<label>Categoría<select name="category"><option>Movie</option><option>Series</option><option value="">Todas</option></select></label>
<label><input type="checkbox" name="avoid_repeat" value="1" checked> Ciclo sin repetir hasta agotar</label>
<button>⚡ GENERAR MES POR SEMANAS</button>
</form>
<div class="info">Cada día se llena de 00:00:00 a 24:00:00. En aleatorio se baraja un ciclo y solo vuelve a mezclar cuando se agota.</div>
</section>
<section class="card"><h2>🗓️ Generar una semana</h2>
<form method="post" action="/generate-week" class="form">
<label>Inicio<input type="date" name="start_date" value="{{today}}" required></label>
<label>Modo<select name="mode"><option value="random">🎲 ALEATORIO</option><option value="sequential">📋 SECUENCIAL</option></select></label>
<label>Categoría<select name="category"><option>Movie</option><option>Series</option><option value="">Todas</option></select></label>
<label><input type="checkbox" name="avoid_repeat" value="1" checked> Ciclo sin repetir</label>
<button>＋ GENERAR 7 DÍAS</button>
</form>
</section><section class="card">
<h2>➕ Agregar contenido al Scheduler</h2>
<p>Selecciona una película del Media Pool, indica fecha/hora y agrégala manualmente. También puedes usar arrastrar y soltar.</p>
<div id="dropScheduler" class="dropzone">ARRASTRA UNA PELÍCULA AQUÍ</div>
<div id="manualSelected" class="info">Ningún medio seleccionado.</div>
<form method="post" action="/schedule/add" id="manualScheduleForm" class="form">
<input type="hidden" name="mid" id="manualMid">
<label>Inicio<input type="datetime-local" name="start_at" id="manualStart" required></label>
<label>Audio<input type="number" name="audio_index" id="manualAudio" value="0" min="0"></label>
<label>Subtítulo<input type="number" name="subtitle_index" id="manualSub" value="-1" min="-1"></label>
<label>Tipo<select name="kind"><option>PROGRAM</option><option>COMMERCIAL</option><option>PROMO</option></select></label>
<button>＋ AGREGAR AL SCHEDULER</button>
</form>
</section>
<section class="card">
<h2>🛠️ Scheduler / Editor AJAX</h2>
<div class="libraryToolbar"><input id="schedSearch" placeholder="🔎 Buscar película..." oninput="scheduleSearch(this.value)"><input id="schedDay" type="date" onchange="loadSchedule(1)"><span id="schedulePager"></span></div>
<div class="table-responsive"><table id="scheduleTable"><thead><tr><th>Fecha / hora</th><th>Contenido</th><th>Tipo</th><th>Audio</th><th>SRT</th><th></th></tr></thead><tbody><tr><td colspan="6">Cargando...</td></tr></tbody></table></div>
</section>
<section class="card"><h2>📢 Agregar anuncio manualmente</h2>
<p>Selecciona un medio de categoría Commercial/Promo y colócalo directamente en el playout.</p>
<form method="post" action="/schedule/add-ad" class="form">
<label>Anuncio<select name="mid">{% for m in media %}{% if m.category in ['Commercial','Promo'] %}<option value="{{m.id}}">{{m.title}} · {{'%.1f'|format(m.duration/60)}} min</option>{% endif %}{% endfor %}</select></label>
<label>Inicio<input type="datetime-local" name="start_at" required></label>
<label>Audio<input type="number" name="audio_index" min="0" value="0"></label>
<label>Subtítulo<input type="number" name="subtitle_index" min="-1" value="-1"></label>
<button>＋ INSERTAR ANUNCIO</button></form></section>
{% elif tab=='recovery' %}
<section class="card"><h2>🛡️ Recovery / Continuidad 24/7</h2>
<p>TVPlayout guarda la posición real de la Media Source de OBS periódicamente. Si OBS o TVPlayout se reinicia, intenta continuar la película desde el punto correcto.</p>
<form method="post" action="/config/recovery" class="form">
<label><input type="checkbox" name="enabled" value="1" {% if cfg.recovery.enabled %}checked{% endif %}> Activar Recovery</label>
<label>Checkpoint (segundos)<input type="number" name="checkpoint_seconds" min="1" step="1" value="{{cfg.recovery.checkpoint_seconds}}"></label>
<label><input type="checkbox" name="auto_restart_obs" value="1" {% if cfg.recovery.auto_restart_obs %}checked{% endif %}> Reiniciar OBS automáticamente</label>
<label>OBS executable<input name="obs_exe" value="{{cfg.recovery.obs_exe}}"></label>
<button type="button" onclick="refreshOBS()">🔄 ACTUALIZAR OBS</button><button>💾 GUARDAR RECOVERY</button>
</form>
</section>
<section class="card"><h2>📡 Estado de recuperación</h2>
<div id="recoveryStatus">Cargando...</div>
<form method="post" action="/recovery/test"><button>🧪 PROBAR RECOVERY AHORA</button></form>
</section>
{% elif tab=='logo' %}
<section class="card"><h2>🏷️ Configuración de Logo de Tanda</h2>
<p>Selecciona exactamente la escena y fuente de OBS donde está el logo. Durante COMMERCIAL se activa esa fuente.</p>
<form method="post" action="/config/logo-v10" class="form">
<label>Escena del logo<select name="scene"><option value="">-- Seleccionar escena --</option>
{% for sc in obs.scenes %}<option value="{{sc.scene}}" {% if sc.scene==cfg.logo.scene %}selected{% endif %}>{{sc.scene}}</option>{% endfor %}</select></label>
<label>Fuente del logo<select name="source"><option value="">-- Seleccionar fuente --</option>
{% for sc in obs.scenes %}{% for x in sc.sources %}<option value="{{x}}" {% if x==cfg.logo.source %}selected{% endif %}>{{sc.scene}} → {{x}}</option>{% endfor %}{% endfor %}</select></label>
<label><input type="checkbox" name="enabled" value="1" {% if cfg.logo.enabled %}checked{% endif %}> Activar logo</label>
<label><input type="checkbox" name="show_during_ads" value="1" {% if cfg.logo.show_during_ads %}checked{% endif %}> Mostrar durante anuncios</label>
<button>💾 GUARDAR LOGO</button></form>
</section>
{% elif tab=='ads' %}<section class="card"><h2>📢 Auto anuncios aleatorios</h2><form method="post" action="/config/ads" class="form"><label><input type="checkbox" name="enabled" value="1" {% if cfg.auto_ads.enabled %}checked{% endif %}> Activar</label><label>Intervalo<input type="number" name="interval_minutes" value="{{cfg.auto_ads.interval_minutes}}"></label><label>Objetivo tanda (seg)<input type="number" name="break_seconds" value="{{cfg.auto_ads.break_seconds}}"></label><label>Mínimo<input type="number" name="min_ads" value="{{cfg.auto_ads.min_ads}}"></label><label>Máximo<input type="number" name="max_ads" value="{{cfg.auto_ads.max_ads}}"></label><label>Categoría<select name="category"><option>Commercial</option><option>Promo</option></select></label><label><input type="checkbox" name="avoid_repeat" value="1" {% if cfg.auto_ads.avoid_repeat %}checked{% endif %}> No repetir</label><button>Guardar</button></form></section>
{% elif tab=='settings' %}
<section class="card"><h2>⚙️ Salida de Playout / OBS</h2>
<p>Esta sección controla exactamente qué escena y qué fuente recibe las películas del playout.</p>
<form method="post" action="/config/channel" class="form">
<label>Nombre del canal<input name="name" value="{{cfg.channel.name}}"></label>
<label>Escena de Playout<select name="scene" id="outScene">
<option value="">-- Seleccionar escena --</option>
{% for sc in obs.scenes %}<option value="{{sc.scene}}" {% if sc.scene==cfg.channel.scene %}selected{% endif %}>{{sc.scene}}</option>{% endfor %}
</select></label>
<label>Fuente de Playout<select name="source" id="outSource">
<option value="">-- Seleccionar fuente --</option>
{% for sc in obs.scenes %}{% for x in sc.sources %}<option value="{{x}}" data-scene="{{sc.scene}}" {% if x==cfg.channel.source %}selected{% endif %}>{{sc.scene}} → {{x}}</option>{% endfor %}{% endfor %}
</select></label>
<button>💾 GUARDAR SALIDA</button>
</form>
<div class="info"><b>Recomendado:</b> crea en OBS una escena como <b>MOVIES HD</b> y dentro una fuente <b>PLAYOUT</b> de tipo Media Source. Selecciona ambos aquí.</div>
</section>
<section class="card"><h2>🔌 Estado OBS</h2><p>Conexión: <b>{{'CONECTADO' if obs.connected else 'DESCONECTADO'}}</b></p>{% if not obs.connected %}<div class="error">{{obs.error}}</div>{% endif %}</section>
{% else %}<section class="grid">
<section class="card"><div class="eyebrow">ON AIR</div><h2>{{current_event.title if current_event else (state.current.title if state.current else 'SIN CONTENIDO')}}</h2>
{% if current_event %}<p><b>Inicio:</b> {{current_event.start_at[0:10]}} {{current_event.start_at[11:19]}} · <b>Fin:</b> {{current_event.end_at[11:19]}}</p><p>Audio: <b id="liveAudioLabel">{{current_event.audio_index}}</b> · Subtítulos: <b id="liveSubLabel">{{current_event.subtitle_index}}</b></p>
<form id="liveEditForm" class="form"><input type="hidden" name="sid" value="{{current_event.id}}"><input type="hidden" name="start_at" value="{{current_event.start_at[:16]}}"><input type="hidden" name="kind" value="{{current_event.kind}}">
<label>Audio<select name="audio_index">{% for a in (current_event.audio_json|fromjson) %}<option value="{{a.ordinal}}" {% if a.ordinal==current_event.audio_index %}selected{% endif %}>{{a.language|upper}}{% if a.title %} — {{a.title}}{% endif %}</option>{% endfor %}</select></label>
<label>Subtítulo<select name="subtitle_index"><option value="-1" {% if current_event.subtitle_index<0 %}selected{% endif %}>Ninguno</option>{% for sub in (current_event.subs_json|fromjson) %}<option value="{{sub.ordinal}}" {% if sub.ordinal==current_event.subtitle_index %}selected{% endif %}>{{sub.language|upper}}{% if sub.title %} — {{sub.title}}{% endif %}{% if sub.external %} (SRT){% endif %}</option>{% endfor %}</select></label><button type="submit">💾 CAMBIAR EN VIVO</button></form>
<div id="liveEditMsg" class="info"></div>{% else %}<p>No hay evento al aire.</p>{% endif %}</section>
<section class="card"><h2>🛡️ PLAYBACK RECOVERY</h2><div id="playbackRecovery">Cargando posición...</div></section>
<section class="card"><h2>⏭️ NEXT</h2>{% if state.next %}<p><b>{{state.next.title}}</b></p><small>{{state.next.start_at[0:10]}} {{state.next.start_at[11:19]}} · {{'%.1f'|format(state.next.duration/60)}} min · {{state.next.kind}}</small>{% else %}<p>No hay siguiente evento programado.</p>{% endif %}</section>
<section class="card"><h2>OBS</h2><p>Escena: {{cfg.channel.scene or 'No configurada'}}</p><p>Fuente: {{cfg.channel.source or 'No configurada'}}</p></section></section>
<section class="card"><h2>🎬 PLAYOUT + MEDIA POOL</h2><p>Lista rápida de 20 películas. Desde aquí puedes programar, editar pistas o tomar una película inmediatamente.</p><div class="libraryToolbar"><input id="playoutSearch" placeholder="🔎 Buscar película..." oninput="playoutSearch(this.value)"><span id="playoutPager"></span></div><div id="playoutMediaPool" class="media"></div></section>
<section class="card"><h2>📋 Próximos eventos</h2><div class="table-responsive"><table><tr><th>Fecha</th><th>Hora</th><th>Contenido</th><th>Tipo</th></tr>{% for s in schedules[:20] %}<tr><td>{{s.start_at[0:10]}}</td><td><b>{{s.start_at[11:19]}}</b></td><td>{{s.title}}</td><td>{{s.kind}}</td></tr>{% endfor %}</table></div></section>
{% endif %}
<div id="mediaModal" class="modalWrap" style="display:none"><div class="modalBox"><button class="modalClose" onclick="closeMediaEditor()">×</button><h2>🎬 Editar película</h2><input type="hidden" id="mmId"><label>Título<input id="mmTitle"></label><label>Audio<select id="mmAudio"></select></label><label>Subtítulo<select id="mmSub"></select></label><div class="twobtn"><button onclick="saveMediaEditor()">💾 GUARDAR</button><button class="danger" onclick="closeMediaEditor()">CANCELAR</button></div></div></div></main><script>
window.TV_TAB={{tab|tojson}};
let libraryPage=1, libraryQ="";

function escapeHtml(x){return String(x??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');}
function escapeAttr(x){return escapeHtml(x).replace(/`/g,'&#96;');}

async function loadLibrary(page=1){
 if(window.TV_TAB!=="library") return;
 libraryPage=page;
 const el=document.getElementById("liveMediaPool"); if(!el)return;
 try{
  const r=await fetch(`/api/library?page=${page}&per_page=20&q=${encodeURIComponent(libraryQ)}`,{cache:"no-store"});
  const d=await r.json(); el.innerHTML="";
  (d.items||[]).forEach(m=>{
   const row=document.createElement("article");
   row.className="mediaRow";
   let a=[],subs=[];
   try{a=JSON.parse(m.audio_json||"[]")}catch(e){}
   try{subs=JSON.parse(m.subs_json||"[]")}catch(e){}
   row.innerHTML=`<b>${escapeHtml(m.title||"Sin título")}</b>
   <small>${escapeHtml(m.category||"Movie")} · ${((m.duration||0)/60).toFixed(1)} min · ${m.width||0}×${m.height||0}</small>
   <small>${escapeHtml(m.path||"")}</small>
   <div class="twobtn"><button type="button" onclick='chooseMedia(${JSON.stringify(m)})'>＋ SCHEDULER</button>
   <button type="button" onclick='chooseMedia(${JSON.stringify(m)})'>⚙ SELECCIONAR</button></div>`;
   row.draggable=true;
   row.addEventListener("dragstart",e=>e.dataTransfer.setData("application/json",JSON.stringify(m)));
   el.appendChild(row);
  });
  const pg=document.getElementById("libraryPager");
  if(pg)pg.innerHTML=`<button ${d.page<=1?"disabled":""} onclick="loadLibrary(${d.page-1})">‹</button> ${d.page}/${d.pages} <button ${d.page>=d.pages?"disabled":""} onclick="loadLibrary(${d.page+1})">›</button> · ${d.count}`;
 }catch(e){console.error(e);}
}
function searchLibrary(v){libraryQ=v;loadLibrary(1);}
function chooseMedia(m){
 const mid=document.getElementById("manualMid"); if(mid)mid.value=m.id;
 const info=document.getElementById("manualSelected"); if(info)info.textContent=m.title||"";
}
function setupDrop(){
 const dz=document.getElementById("dropScheduler"); if(!dz)return;
 dz.addEventListener("dragover",e=>{e.preventDefault();dz.classList.add("dragover")});
 dz.addEventListener("dragleave",()=>dz.classList.remove("dragover"));
 dz.addEventListener("drop",e=>{
  e.preventDefault();dz.classList.remove("dragover");
  try{
   const m=JSON.parse(e.dataTransfer.getData("application/json")); chooseMedia(m);
   const now=new Date();now.setSeconds(0,0);
   const p=n=>String(n).padStart(2,"0");
   const v=`${now.getFullYear()}-${p(now.getMonth()+1)}-${p(now.getDate())}T${p(now.getHours())}:${p(now.getMinutes())}`;
   const input=document.getElementById("manualStart");if(input)input.value=v;
  }catch(err){}
 });
}
if(window.TV_TAB==="library"){loadLibrary(1);}
if(window.TV_TAB==="scheduler"){setupDrop();}
</script>

<script>
let schedulePage=1,scheduleQ='';
function scheduleSearch(v){scheduleQ=v;loadSchedule(1);}
function trackOptions(json,selected,type){let a=[];try{a=JSON.parse(json||'[]')}catch(e){};if(type==='sub'){return '<option value="-1" '+(selected<0?'selected':'')+'>Ninguno</option>'+a.map(x=>`<option value="${x.ordinal}" ${x.ordinal==selected?'selected':''}>${escapeHtml((x.language||'und').toUpperCase())}${x.title?' — '+escapeHtml(x.title):''}${x.external?' (SRT)':''}</option>`).join('')}return a.map(x=>`<option value="${x.ordinal}" ${x.ordinal==selected?'selected':''}>${escapeHtml((x.language||'und').toUpperCase())}${x.title?' — '+escapeHtml(x.title):''}</option>`).join('')||'<option value="0">DEFAULT</option>';}
async function loadSchedule(page=1){if(window.TV_TAB!=='scheduler')return;schedulePage=page;const day=document.getElementById('schedDay')?.value||'';const tb=document.querySelector('#scheduleTable tbody');if(!tb)return;tb.innerHTML='<tr><td colspan="6">Cargando...</td></tr>';try{const r=await fetch(`/api/schedule?page=${page}&per_page=20&q=${encodeURIComponent(scheduleQ)}&day=${encodeURIComponent(day)}`,{cache:'no-store'});const d=await r.json();tb.innerHTML='';(d.items||[]).forEach(s=>{const tr=document.createElement('tr');tr.dataset.id=s.id;tr.innerHTML=`<td><input class="sched-start" type="datetime-local" value="${s.start_at.slice(0,16)}"></td><td><b>${escapeHtml(s.title)}</b><br><small>${(s.duration/60).toFixed(1)} min</small></td><td><select class="sched-kind"><option ${s.kind==='PROGRAM'?'selected':''}>PROGRAM</option><option ${s.kind==='COMMERCIAL'?'selected':''}>COMMERCIAL</option><option ${s.kind==='PROMO'?'selected':''}>PROMO</option></select></td><td><select class="sched-audio">${trackOptions(s.audio_json,s.audio_index,'audio')}</select></td><td><select class="sched-sub">${trackOptions(s.subs_json,s.subtitle_index,'sub')}</select></td><td><button onclick="saveScheduleRow(${s.id},this)">💾</button> <button class="danger" onclick="deleteSchedule(${s.id})">🗑</button></td>`;tb.appendChild(tr)});const pg=document.getElementById('schedulePager');if(pg)pg.innerHTML=`<button ${d.page<=1?'disabled':''} onclick="loadSchedule(${d.page-1})">‹</button> ${d.page}/${d.pages} <button ${d.page>=d.pages?'disabled':''} onclick="loadSchedule(${d.page+1})">›</button> · ${d.count}`;}catch(e){tb.innerHTML=`<tr><td colspan="6" class="error">${escapeHtml(e)}</td></tr>`}}
async function saveScheduleRow(id,btn){const tr=btn.closest('tr');const payload={sid:id,start_at:tr.querySelector('.sched-start').value,audio_index:+tr.querySelector('.sched-audio').value,subtitle_index:+tr.querySelector('.sched-sub').value,kind:tr.querySelector('.sched-kind').value};btn.disabled=true;try{const r=await fetch('/api/schedule/update',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const d=await r.json();if(!d.ok)throw Error(d.error||'No se pudo guardar');btn.textContent=d.live?'✓ LIVE':'✓';setTimeout(()=>btn.textContent='💾',1500);}catch(e){alert(e.message)}finally{btn.disabled=false}}
async function deleteSchedule(id){if(!confirm('¿Quitar este evento?'))return;await fetch('/schedule/delete/'+id,{method:'POST'});loadSchedule(schedulePage)}
if(window.TV_TAB==='scheduler'){loadSchedule(1)}
async function playoutSearch(v){window.playoutQ=v;loadPlayoutMedia(1)}
async function loadPlayoutMedia(page=1){if(window.TV_TAB!=='playout')return;const q=window.playoutQ||'';const el=document.getElementById('playoutMediaPool');if(!el)return;const r=await fetch(`/api/library?page=${page}&per_page=20&q=${encodeURIComponent(q)}`,{cache:'no-store'});const d=await r.json();el.innerHTML='';(d.items||[]).forEach(m=>{const a=JSON.parse(m.audio_json||'[]'),s=JSON.parse(m.subs_json||'[]');const x=document.createElement('article');x.innerHTML=`<b>${escapeHtml(m.title)}</b><small>${(m.duration/60).toFixed(1)} min</small><div class="twobtn"><button onclick='openMediaEditor(${JSON.stringify(m)})'>⚙ PISTAS</button><button onclick='takeMedia(${m.id})'>▶ TOMAR</button><button onclick='scheduleMedia(${m.id})'>＋ PROGRAMAR</button></div>`;el.appendChild(x)});const pg=document.getElementById('playoutPager');if(pg)pg.innerHTML=`<button ${d.page<=1?'disabled':''} onclick="loadPlayoutMedia(${d.page-1})">‹</button> ${d.page}/${d.pages} <button ${d.page>=d.pages?'disabled':''} onclick="loadPlayoutMedia(${d.page+1})">›</button> · ${d.count}`}
async function takeMedia(id){await fetch('/take/'+id,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'audio_index=0&subtitle_index=-1'});location.reload()}
function scheduleMedia(id){document.getElementById('manualMid').value=id;document.getElementById('manualSelected').textContent='Medio #'+id;window.scrollTo({top:0,behavior:'smooth'});}
function openMediaEditor(m){const modal=document.getElementById('mediaModal');if(!modal)return;document.getElementById('mmId').value=m.id;document.getElementById('mmTitle').value=m.title;document.getElementById('mmAudio').innerHTML=trackOptions(m.audio_json,0,'audio');document.getElementById('mmSub').innerHTML=trackOptions(m.subs_json,-1,'sub');modal.style.display='flex'}
function closeMediaEditor(){document.getElementById('mediaModal').style.display='none'}
async function saveMediaEditor(){const id=+document.getElementById('mmId').value;const fd=new URLSearchParams({mid:id,title:document.getElementById('mmTitle').value,category:'Movie',audio_default:document.getElementById('mmAudio').value,subtitle_default:document.getElementById('mmSub').value});await fetch('/media/update',{method:'POST',body:fd});closeMediaEditor();if(window.TV_TAB==='playout')loadPlayoutMedia(1);else loadLibrary(1)}
function setupLiveEditor(){const f=document.getElementById('liveEditForm');if(!f)return;f.addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(f);const payload={sid:+fd.get('sid'),start_at:fd.get('start_at'),audio_index:+fd.get('audio_index'),subtitle_index:+fd.get('subtitle_index'),kind:fd.get('kind')};const msg=document.getElementById('liveEditMsg');msg.textContent='Preparando pista...';try{const r=await fetch('/api/schedule/update',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const d=await r.json();if(!d.ok)throw Error(d.error||'Error');msg.textContent=d.live?'✓ Audio/SRT actualizado en vivo.':'✓ Guardado sin tocar OBS.';}catch(e){msg.textContent='✕ '+e.message}})}
setupLiveEditor();if(window.TV_TAB==='playout'){loadPlayoutMedia(1)}
</script>
<script>
async function refreshScanner(){
 if(window.TV_TAB!=="scanner")return;
 try{
  const r=await fetch('/api/library?page=1&per_page=10',{cache:'no-store'}),d=await r.json();
  const el=document.getElementById('scanStatus');
  if(el)el.innerHTML=`<b>Estado:</b> ${d.scanner.running?'ESCANEANDO':'LISTO'} · <b>Encontrados:</b> ${d.scanner.found} · <b>Analizados:</b> ${d.scanner.analyzed} · <b>Pendientes:</b> ${d.scanner.pending} · <b>En Media Pool:</b> ${d.count}`;
  const bar=document.getElementById('scanProgress');if(bar){bar.max=Math.max(1,d.scanner.found);bar.value=d.scanner.analyzed;}
 }catch(e){}
}
if(window.TV_TAB==="scanner"){refreshScanner();setInterval(refreshScanner,3000);}
</script>

<script>
async function refreshRecovery(){
 if(window.TV_TAB!=="recovery" && window.TV_TAB!=="playout")return;
 try{
  const r=await fetch('/api/recovery',{cache:'no-store'}),d=await r.json();
  const rt=d.runtime||{},cur=d.current||{};
  const pos=(rt.position||0)/1000,dur=rt.duration||cur.duration||0;
  const fmt=x=>{x=Math.max(0,Math.floor(x));const h=Math.floor(x/3600),m=Math.floor((x%3600)/60),s=x%60;return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`};
  const text=`<b>${escapeHtml(cur.title||'Sin película')}</b><br>Posición: <b>${fmt(pos)}</b> / ${fmt(dur)}<br>Estado: ${rt.recovering?'🟡 RECUPERANDO':'🟢 '+escapeHtml(rt.message||'OK')}<br>Último checkpoint: ${escapeHtml(rt.last_checkpoint||'—')}<br>OBS: ${d.obs&&d.obs.connected?'🟢 CONECTADO':'🔴 DESCONECTADO'}`;
  const a=document.getElementById('playbackRecovery');if(a)a.innerHTML=text;
  const b=document.getElementById('recoveryStatus');if(b)b.innerHTML=text;
 }catch(e){}
}
if(window.TV_TAB==="recovery"||window.TV_TAB==="playout"){refreshRecovery();setInterval(refreshRecovery,2000);}
</script>

<script>
async function refreshOBS(){
 try{
  const r=await fetch('/api/obs?refresh=1',{cache:'no-store'}),d=await r.json();
  alert(d.connected?'OBS CONECTADO':'OBS DESCONECTADO'+(d.error?': '+d.error:''));
  location.reload();
 }catch(e){alert('No se pudo consultar OBS: '+e);}
}
</script>
</body></html>
<script>
(function(){
 const q=new URLSearchParams(location.search);
 if(q.get("live")==="1"){
   const n=document.getElementById("liveNotice");
   if(n){n.style.display="block";setTimeout(()=>n.style.display="none",5000);}
   history.replaceState({},document.title,location.pathname+"?tab=playout");
 }
})();
</script>

*{box-sizing:border-box}body{margin:0;background:#0b1016;color:#edf2f7;font:14px Arial}header{padding:20px 4%;background:#141a21;border-bottom:1px solid #293340;display:flex;justify-content:space-between;align-items:center}h1{margin:0 0 5px}header span,small,p{color:#9aa7b5}.status{padding:10px 15px;border-radius:8px;font-weight:bold}.ok{background:#103a28;color:#62dfa0}.bad{background:#472020;color:#ff9696}nav{display:flex;gap:3px;padding:0 4%;background:#11161d;border-bottom:1px solid #293340;overflow:auto}nav a{padding:14px;color:#aab4c0;text-decoration:none;font-weight:bold;white-space:nowrap}nav a.a{background:#287be9;color:#fff}main{max-width:1500px;margin:auto;padding:0 2%}.card{background:#141a21;border:1px solid #293340;border-radius:12px;padding:18px;margin:18px 0}.grid{display:grid;grid-template-columns:1.4fr 1fr;gap:18px}.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:9px;align-items:end}.form input,.form select,.media select{width:100%;padding:10px;margin-top:5px;background:#0b1016;color:#fff;border:1px solid #3b4652;border-radius:6px}button{padding:10px 14px;border:0;border-radius:6px;background:#287be9;color:#fff;font-weight:bold;cursor:pointer}.row{display:flex;justify-content:space-between;align-items:center;background:#1a222c;padding:12px;border-radius:8px;margin:8px 0}.stats{padding:15px;background:#192331;margin-top:15px}progress{width:100%;height:25px}.error{background:#431f1f;border-left:4px solid #ef5350;padding:10px;margin-top:12px;word-break:break-word}.media{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}.media article{background:#1b232d;border-radius:9px;padding:14px}.media small{display:block;margin-top:5px;word-break:break-all}table{width:100%;border-collapse:collapse}th,td{padding:9px;border-bottom:1px solid #293340;text-align:left}pre{background:#0b1016;padding:15px;border-radius:8px}@media(max-width:800px){.grid{grid-template-columns:1fr}header{flex-direction:column;align-items:flex-start;gap:12px}}

.live-dot{font-size:12px;color:#54d38a;margin-left:10px}
.live-badge{display:inline-block;margin-top:8px;padding:4px 7px;border-radius:5px;background:#103a28;color:#62dfa0;font-size:11px;font-weight:bold}
#scanProgress{width:100%;height:24px;margin-top:10px}

.dropzone{border:2px dashed #3b78c4;border-radius:10px;padding:25px;text-align:center;margin:12px 0;color:#9aa7b5}
.dropzone.dragover{background:#172d46;color:#fff;border-color:#55a2ff}
.poolBtn{margin-top:9px;width:100%}

.inlineform{display:inline}.inlineform input,.inlineform select{max-width:180px;padding:7px;background:#0b1016;color:#fff;border:1px solid #3b4652;border-radius:5px}.twobtn{display:flex;gap:6px;margin-top:8px}.danger{background:#983737}.media article form{display:grid;gap:6px;margin-top:8px}.media article form input,.media article form select{margin:0}.media article button{margin-top:5px}

.mediaRow{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 12px;border-bottom:1px solid rgba(128,128,128,.18)}
.mediaMain{min-width:0}.mediaMain b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mediaMain small{display:block;opacity:.72;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:70vw}
.mediaActions{display:flex;gap:6px;flex-shrink:0}.libraryToolbar{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:10px}.libraryToolbar input{flex:1}

.table-responsive{overflow:auto}.modalWrap{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:9999;align-items:center;justify-content:center}.modalBox{background:#141a21;border:1px solid #3b4652;border-radius:12px;padding:24px;width:min(600px,92vw);box-shadow:0 20px 80px #000}.modalBox label{display:block;margin:12px 0}.modalBox input,.modalBox select{width:100%;padding:10px;margin-top:5px;background:#0b1016;color:#fff;border:1px solid #3b4652;border-radius:6px}.modalClose{float:right;background:#431f1f;font-size:20px;padding:4px 10px}.table-responsive table{min-width:1000px}.eyebrow{font-size:11px;letter-spacing:1px;color:#58d68d;font-weight:800}.media article{min-height:120px}.info{padding:9px;background:#172333;border-radius:7px;margin-top:8px}
